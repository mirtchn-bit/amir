        ];

        /* Categories List */
        const categories = [
            "Barchasi",
            "Ta'lim (Edu)",
            "Ish va Martaba",
            "Texnologiya",
            "Biznes & Moliya",
            "Shaxsiy Rivojlanish",
            "Reklama & Hamkorlik"
        ];

        let activeCategory = "Barchasi";
        let layoutMode = "grid"; // 'grid' or 'feed'
        let currentReelIndex = 0;
        let activeCommentVideoId = null;

        // Initialize App on DOM Load
        document.addEventListener('DOMContentLoaded', () => {
            renderCategories();
            renderVideos();
            lucide.createIcons();
        });

        /* Render Category Selector Pills */
        function renderCategories() {
            const catContainer = document.getElementById('categoryBar');
            catContainer.innerHTML = categories.map(cat => {
                const isActive = cat === activeCategory;
                return `
                    <button onclick="selectCategory('${cat}')" 
                        class="px-3.5 py-1.5 rounded-xl text-xs font-semibold whitespace-nowrap transition-all border ${
                            isActive 
                            ? 'bg-cyanNeon text-gray-950 border-cyanNeon shadow-neon-cyan' 
                            : 'bg-gray-900 text-gray-400 border-gray-800 hover:text-white hover:border-gray-700'
                        }">
                        ${cat}
                    </button>
                `;
            }).join('');
        }

        /* Filter Category Click Handler */
        function selectCategory(cat) {
            activeCategory = cat;
            renderCategories();
            document.getElementById('currentCategoryTitle').innerHTML = `
                <i data-lucide="sparkles" class="w-5 h-5 text-cyanNeon"></i> ${cat === 'Barchasi' ? 'Barcha Foydali Videolar' : cat}
            `;
            renderVideos();
            lucide.createIcons();
        }

        /* Switch Layout Grid / Feed Mode */
        function setFeedLayout(mode) {
            layoutMode = mode;
            document.getElementById('btn-layout-grid').className = mode === 'grid' ? 'p-1.5 rounded-lg text-cyanNeon bg-gray-800 transition-all' : 'p-1.5 rounded-lg text-gray-400 hover:text-white transition-all';
            document.getElementById('btn-layout-feed').className = mode === 'feed' ? 'p-1.5 rounded-lg text-cyanNeon bg-gray-800 transition-all' : 'p-1.5 rounded-lg text-gray-400 hover:text-white transition-all';
            
            const container = document.getElementById('videosContainer');
            if (mode === 'grid') {
                container.className = "grid grid-cols-1 md:grid-cols-2 gap-5";
            } else {
                container.className = "flex flex-col max-w-xl mx-auto space-y-6";
            }
        }

        /* Render Main Videos Grid / List */
        function renderVideos() {
            const container = document.getElementById('videosContainer');
            let filtered = sampleVideos;

            if (activeCategory !== "Barchasi") {
                filtered = sampleVideos.filter(v => v.category === activeCategory);
            }

            // Search filter
            const searchVal = document.getElementById('searchInput')?.value.toLowerCase();
            if (searchVal) {
                filtered = filtered.filter(v => 
                    v.title.toLowerCase().includes(searchVal) || 
                    v.tags.toLowerCase().includes(searchVal) ||
                    v.author.toLowerCase().includes(searchVal)
                );
            }

            document.getElementById('videoCountBadge').innerText = `${filtered.length} video`;

            if (filtered.length === 0) {
                container.innerHTML = `
                    <div class="col-span-full glass-panel p-8 text-center rounded-2xl border border-gray-800">
                        <i data-lucide="search-x" class="w-10 h-10 text-gray-500 mx-auto mb-2"></i>
                        <h4 class="text-base font-bold text-gray-300">Ushbu bo'limda video topilmadi</h4>
                        <p class="text-xs text-gray-500 mt-1">Birinchi bo'lib foydali video yuklang!</p>
                    </div>
                `;
                lucide.createIcons();
                return;
            }

            container.innerHTML = filtered.map(v => createVideoCardHTML(v)).join('');
            lucide.createIcons();
        }

        /* Create Video Card HTML Component */
        function createVideoCardHTML(v) {
            return `
                <div class="glass-panel rounded-2xl overflow-hidden border border-gray-800/80 hover:border-cyanNeon/40 transition-all duration-300 flex flex-col justify-between group shadow-lg hover:shadow-glow-card">
                    <!-- Top Author Header -->
                    <div class="p-3.5 flex items-center justify-between border-b border-gray-800/50">
                        <div class="flex items-center gap-2.5">
                            <img src="${v.avatar}" class="w-8 h-8 rounded-xl object-cover border border-cyanNeon/30">
                            <div class="flex flex-col">
                                <span class="text-xs font-bold text-white flex items-center gap-1">
                                    ${v.author}
                                    ${v.verified ? '<i data-lucide="check-circle-2" class="w-3.5 h-3.5 text-cyanNeon inline"></i>' : ''}
                                </span>
                                <span class="text-[10px] text-gray-400">${v.handle}</span>
                            </div>
                        </div>

                        <span class="text-[10px] font-bold px-2 py-0.5 rounded-md bg-gray-900 text-cyanNeon border border-cyanNeon/20">
                            ${v.category}
                        </span>
                    </div>

                    <!-- Video Container -->
                    <div class="relative bg-black aspect-video overflow-hidden group/video">
                        <video id="vid-${v.id}" class="w-full h-full object-cover" loop muted playsinline>
                            <source src="${v.videoUrl}" type="video/mp4">
                        </video>

                        <!-- Video Play/Pause Overlay Controls -->
                        <div class="absolute inset-0 bg-black/20 opacity-0 group-hover/video:opacity-100 transition-opacity flex items-center justify-center gap-3">
                            <button onclick="togglePlayVideo(${v.id})" class="p-3 rounded-full bg-cyanNeon text-gray-950 hover:scale-110 transition-transform shadow-neon-cyan">
                                <i data-lucide="play" class="w-5 h-5 fill-current"></i>
                            </button>
                            <button onclick="toggleMuteVideo(${v.id})" class="p-3 rounded-full bg-gray-900/80 text-white border border-gray-700 hover:scale-110 transition-transform">
                                <i data-lucide="volume-2" class="w-5 h-5"></i>
                            </button>
                        </div>

                        <!-- Impact Badge -->
                        <div class="absolute top-2 right-2 bg-gray-950/80 backdrop-blur-md px-2.5 py-1 rounded-lg border border-crimsonRed/50 flex items-center gap-1 text-[10px] font-bold text-crimsonNeon">
                            <i data-lucide="shield-check" class="w-3 h-3 text-crimsonRed"></i>
                            ${v.impactRating}
                        </div>
                    </div>

                    <!-- Description & Takeaway Section -->
                    <div class="p-4 flex-1 flex flex-col justify-between">
                        <div>
                            <h3 class="text-sm font-bold text-white mb-1.5 line-clamp-1 group-hover:text-cyanNeon transition-colors">${v.title}</h3>
                            <p class="text-xs text-gray-300 bg-gray-900/60 p-2.5 rounded-xl border border-gray-800/60 mb-2 leading-relaxed">
                                <strong class="text-cyanNeon font-semibold">Xulosa:</strong> ${v.summary}
                            </p>
                            <div class="text-[11px] text-cyanAccent font-medium">${v.tags}</div>
                        </div>

                        <!-- Interaction Buttons Bar -->
                        <div class="flex items-center justify-between pt-3 mt-3 border-t border-gray-800/60 text-xs">
                            <div class="flex items-center gap-4">
                                <button onclick="toggleLike(${v.id})" class="flex items-center gap-1.5 text-gray-400 hover:text-crimsonNeon transition-colors ${v.isLiked ? 'text-crimsonNeon font-bold' : ''}">
                                    <i data-lucide="heart" class="w-4 h-4 ${v.isLiked ? 'fill-crimsonNeon text-crimsonNeon' : ''}"></i>
                                    <span>${v.likes}</span>
                                </button>

                                <button onclick="openCommentsModal(${v.id})" class="flex items-center gap-1.5 text-gray-400 hover:text-cyanNeon transition-colors">
                                    <i data-lucide="message-square" class="w-4 h-4"></i>
                                    <span>${v.commentsCount}</span>
                                </button>

                                <button onclick="openShareModal(${v.id})" class="text-gray-400 hover:text-white transition-colors">
                                    <i data-lucide="share-2" class="w-4 h-4"></i>
                                </button>
                            </div>

                            <button onclick="toggleBookmark(${v.id})" class="text-gray-400 hover:text-yellow-400 transition-colors ${v.isBookmarked ? 'text-yellow-400' : ''}">
                                <i data-lucide="bookmark" class="w-4 h-4 ${v.isBookmarked ? 'fill-yellow-400' : ''}"></i>
                            </button>
                        </div>
                    </div>
                </div>
            `;
        }

        /* Video Play / Mute Mechanics */
        function togglePlayVideo(id) {
            const vid = document.getElementById(`vid-${id}`);
            if (vid.paused) {
                vid.play();
            } else {
                vid.pause();
            }
        }

        function toggleMuteVideo(id) {
            const vid = document.getElementById(`vid-${id}`);
            vid.muted = !vid.muted;
        }

        /* Toggle Like Status */
        function toggleLike(id) {
            const video = sampleVideos.find(v => v.id === id);
            if (video) {
                video.isLiked = !video.isLiked;
                video.likes += video.isLiked ? 1 : -1;
                renderVideos();
                renderBookmarks();
            }
        }

        /* Toggle Bookmark Status */
        function toggleBookmark(id) {
            const video = sampleVideos.find(v => v.id === id);
            if (video) {
                video.isBookmarked = !video.isBookmarked;
                renderVideos();
                renderBookmarks();
            }
        }

        /* Switch Active Main Tab Views */
        function switchTab(tabName) {
            document.querySelectorAll('.view-panel').forEach(el => el.classList.add('hidden'));
            document.querySelectorAll('.nav-btn').forEach(el => {
                el.classList.remove('text-cyanNeon', 'bg-cyanNeon/10', 'border', 'border-cyanNeon/30');
                el.classList.add('text-gray-400');
            });

            const targetNav = document.getElementById(`nav-${tabName}`);
            if (targetNav) {
                targetNav.classList.remove('text-gray-400');
                targetNav.classList.add('text-cyanNeon', 'bg-cyanNeon/10', 'border', 'border-cyanNeon/30');
            }

            document.getElementById(`view-${tabName}`).classList.remove('hidden');

            if (tabName === 'reels') {
                renderReelView();
            } else if (tabName === 'bookmarks') {
                renderBookmarks();
            } else if (tabName === 'profile') {
                renderProfileVideos();
            }

            lucide.createIcons();
        }

        /* Render Focus Reels Mode View */
        function renderReelView() {
            const container = document.getElementById('reelsContainer');
            const v = sampleVideos[currentReelIndex];
            
            document.getElementById('reelsCounter').innerText = `${currentReelIndex + 1} / ${sampleVideos.length}`;

            container.innerHTML = `
                <video id="reelVideo" class="absolute inset-0 w-full h-full object-cover" autoplay loop muted playsinline>
                    <source src="${v.videoUrl}" type="video/mp4">
                </video>

                <!-- Gradient Overlay -->
                <div class="absolute inset-0 bg-gradient-to-t from-black via-black/20 to-transparent pointer-events-none"></div>

                <!-- Reels Information Overlays -->
                <div class="relative z-10 p-5 flex flex-col justify-end h-full text-white">
                    <div class="flex items-center gap-2 mb-2">
                        <img src="${v.avatar}" class="w-8 h-8 rounded-full border border-cyanNeon">
                        <span class="text-xs font-bold">${v.author}</span>
                        <span class="text-[10px] bg-cyanNeon/20 text-cyanNeon px-2 py-0.5 rounded-full border border-cyanNeon/40">${v.category}</span>
                    </div>

                    <h3 class="text-sm font-bold mb-1">${v.title}</h3>
                    <p class="text-xs text-gray-300 line-clamp-2 mb-2">${v.summary}</p>
                    <div class="text-[11px] text-cyanAccent mb-3">${v.tags}</div>

                    <div class="flex items-center gap-4">
                        <button onclick="toggleLike(${v.id}); renderReelView()" class="flex items-center gap-1 text-xs text-gray-300">
                            <i data-lucide="heart" class="w-5 h-5 ${v.isLiked ? 'fill-crimsonNeon text-crimsonNeon' : ''}"></i>
                            ${v.likes}
                        </button>
                        <button onclick="openCommentsModal(${v.id})" class="flex items-center gap-1 text-xs text-gray-300">
                            <i data-lucide="message-square" class="w-5 h-5"></i>
                            ${v.commentsCount}
                        </button>
                        <button onclick="openShareModal(${v.id})" class="text-xs text-gray-300">
                            <i data-lucide="share-2" class="w-5 h-5"></i>
                        </button>
                    </div>
                </div>
            `;
            lucide.createIcons();
        }

        function nextReel() {
            if (currentReelIndex < sampleVideos.length - 1) {
                currentReelIndex++;
                renderReelView();
            }
        }

        function prevReel() {
            if (currentReelIndex > 0) {
                currentReelIndex--;
                renderReelView();
            }
        }

        /* Render Bookmarks List */
        function renderBookmarks() {
            const container = document.getElementById('bookmarksContainer');
            const bookmarked = sampleVideos.filter(v => v.isBookmarked);

            if (bookmarked.length === 0) {
                container.innerHTML = `
                    <div class="col-span-full glass-panel p-8 text-center rounded-2xl border border-gray-800">
                        <i data-lucide="bookmark-x" class="w-10 h-10 text-gray-500 mx-auto mb-2"></i>
                        <h4 class="text-base font-bold text-gray-300">Hozircha saqlangan darsliklar yo'q</h4>
                        <p class="text-xs text-gray-500 mt-1">Videolardagi saqlash belgisini bosing.</p>
                    </div>
                `;
            } else {
                container.innerHTML = bookmarked.map(v => createVideoCardHTML(v)).join('');
            }
            lucide.createIcons();
        }

        /* Render Profile Videos Grid */
        function renderProfileVideos() {
            const container = document.getElementById('profileVideosGrid');
            container.innerHTML = sampleVideos.map(v => createVideoCardHTML(v)).join('');
            lucide.createIcons();
        }

        /* Upload Video Modal Controls */
        function openUploadModal() {
            document.getElementById('uploadModal').classList.remove('hidden');
        }

        function closeUploadModal() {
            document.getElementById('uploadModal').classList.add('hidden');
        }

        function handleUploadSubmit(e) {
            e.preventDefault();
            const title = document.getElementById('upTitle').value;
            const category = document.getElementById('upCategory').value;
            const videoUrl = document.getElementById('upVideoUrl').value;
            const summary = document.getElementById('upDescription').value;
            const tags = document.getElementById('upTags').value || '#talim';

            const newVid = {
                id: Date.now(),
                author: "Malika Rahimova",
                handle: "@malika_dev",
                avatar: "https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=100&auto=format&fit=crop&q=80",
                verified: true,
                title: title,
                category: category,
                videoUrl: videoUrl,
                summary: summary,
                tags: tags,
                impactRating: "99% Foydali",
                likes: 1,
                commentsCount: 0,
                isLiked: true,
                isBookmarked: false,
                comments: []
            };

            sampleVideos.unshift(newVid);
            closeUploadModal();
            document.getElementById('uploadForm').reset();
            renderVideos();
            switchTab('home');
        }

        /* Comments Modal Mechanics */
        function openCommentsModal(videoId) {
            activeCommentVideoId = videoId;
            const video = sampleVideos.find(v => v.id === videoId);
            const list = document.getElementById('commentsList');

            if (video.comments.length === 0) {
                list.innerHTML = `<div class="text-center text-xs text-gray-500 py-6">Birinchi bo'lib foydali fikr bildiring!</div>`;
            } else {
                list.innerHTML = video.comments.map(c => `
                    <div class="bg-gray-900/80 p-3 rounded-xl border border-gray-800 text-xs">
                        <strong class="text-cyanNeon block mb-0.5">${c.name}</strong>
                        <p class="text-gray-300">${c.text}</p>
                    </div>
                `).join('');
            }

            document.getElementById('commentsModal').classList.remove('hidden');
        }

        function closeCommentsModal() {
            document.getElementById('commentsModal').classList.add('hidden');
        }

        function handleAddComment(e) {
            e.preventDefault();
            const input = document.getElementById('commentInput');
            const video = sampleVideos.find(v => v.id === activeCommentVideoId);
            
            if (video && input.value.trim()) {
                video.comments.push({
                    name: "Siz (Foydalanuvchi)",
                    text: input.value.trim()
                });
                video.commentsCount++;
                input.value = '';
                openCommentsModal(activeCommentVideoId);
                renderVideos();
            }
        }

        /* Share Modal Controls */
        function openShareModal(id) {
            document.getElementById('shareUrlInput').value = `https://benifit.net/v/${id}`;
            document.getElementById('shareModal').classList.remove('hidden');
        }

        function closeShareModal() {
            document.getElementById('shareModal').classList.add('hidden');
            document.getElementById('copyToast').classList.add('hidden');
        }

        function copyShareUrl() {
            const input = document.getElementById('shareUrlInput');
            input.select();
            document.execCommand('copy');
            document.getElementById('copyToast').classList.remove('hidden');
            setTimeout(() => {
                closeShareModal();
            }, 1200);
        }

        /* Dynamic Search Filter Trigger */
        function handleSearch() {
            renderVideos();
        }
    </script>
</body>
</html>
